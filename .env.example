# Copie para .env e preencha os valores reais
# cp .env.example .env

# Obrigatório: gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-chave-gerada-com-secrets-token-hex-32

# URL do banco PostgreSQL
DATABASE_URL=postgresql://user:password@localhost/escala_naval

# Debug: 1 apenas em desenvolvimento local, nunca em produção
FLASK_DEBUG=0
